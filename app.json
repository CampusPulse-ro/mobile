{
  "expo": {
    "name": "CampusPulse",
    "slug": "campuspulse",
    "version": "0.1.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "campuspulse",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f1115",
    "ios": {
      "bundleIdentifier": "ro.campuspulse.app"
    },
    "android": {
      "package": "ro.campuspulse.app",
      "adaptiveIcon": {
        "backgroundColor": "#0f1115",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f1115",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#4f8cff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f09d721b-fe8d-48ed-aa43-a412d10561ba"
      }
    },
    "owner": "thorsp",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f09d721b-fe8d-48ed-aa43-a412d10561ba",
      "fallbackToCacheTimeout": 5000
    }
  }
}
