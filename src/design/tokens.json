{
  "$description": "CampusPulse design tokens: the one source for web and mobile. W3C Design Tokens (DTCG) format. Change a token in Penpot (token set \"CampusPulse\") and here, then run `bun run design:tokens` in web and in mobile. See docs/design-system.md.",
  "color": {
    "$type": "color",
    "page": { "$value": "#0f1115", "$description": "Screen background" },
    "raised": { "$value": "#181b21", "$description": "Cards, sheets, anything above the page" },
    "sunken": { "$value": "#0b0d10", "$description": "Wells and inputs, below the page" },
    "ink": { "$value": "#e6e8eb", "$description": "Main text" },
    "ink-soft": { "$value": "#c2c8cf", "$description": "Secondary text" },
    "ink-muted": { "$value": "#9aa3ad", "$description": "Hints, captions, disabled text" },
    "line": { "$value": "#262a31", "$description": "Borders and dividers" },
    "line-strong": {
      "$value": "#5d6777",
      "$description": "Borders that must stand out, control edges (3:1 on page and raised)"
    },
    "accent": { "$value": "#4f8cff", "$description": "Primary actions, links, selection" },
    "warn": { "$value": "#f2b84b", "$description": "Warnings and notices" },
    "danger": { "$value": "#f87171", "$description": "Errors and destructive actions" },
    "success": { "$value": "#3ecf8e", "$description": "Success and all-good states" },
    "on-accent": {
      "$value": "{color.page}",
      "$description": "Text and icons on accent or danger fills"
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "Spacing scale. Used by mobile; the web uses Tailwind's default spacing, whose 4px steps hold these values.",
    "xs": { "$value": "4px" },
    "sm": { "$value": "8px" },
    "md": { "$value": "12px" },
    "lg": { "$value": "16px" },
    "xl": { "$value": "24px" },
    "xxl": { "$value": "32px" }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Corner radii, the same on both apps. Web: --radius-sm, --radius-md, --radius-lg, and pill as --radius-full.",
    "sm": { "$value": "8px" },
    "md": { "$value": "12px" },
    "lg": { "$value": "16px" },
    "pill": { "$value": "999px" }
  },
  "font": {
    "$type": "fontFamily",
    "$description": "Font stacks. Web: --font-sans. Mobile uses the platform font.",
    "sans": {
      "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"],
      "$description": "The system UI font"
    }
  },
  "type": {
    "$type": "typography",
    "$description": "The type scale. lineHeight is a ratio of fontSize (DTCG); each description gives size / line height in px.",
    "display": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "34px",
        "fontWeight": 700,
        "lineHeight": 1.1765,
        "letterSpacing": "-0.5px"
      },
      "$description": "34 / 40. Big numbers, the web landing page"
    },
    "title": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "28px",
        "fontWeight": 700,
        "lineHeight": 1.2143,
        "letterSpacing": "-0.3px"
      },
      "$description": "28 / 34. Screen titles"
    },
    "heading": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "20px",
        "fontWeight": 600,
        "lineHeight": 1.4,
        "letterSpacing": "-0.1px"
      },
      "$description": "20 / 28. Section headings, sheet and dialog titles"
    },
    "subtitle": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "16px",
        "fontWeight": 600,
        "lineHeight": 1.5,
        "letterSpacing": "0px"
      },
      "$description": "16 / 24. Card and timetable slot titles"
    },
    "body": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "16px",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0px"
      },
      "$description": "16 / 24. Paragraphs, list item titles"
    },
    "body-small": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "14px",
        "fontWeight": 400,
        "lineHeight": 1.4286,
        "letterSpacing": "0px"
      },
      "$description": "14 / 20. Secondary lines, metadata, banner messages"
    },
    "label": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "14px",
        "fontWeight": 600,
        "lineHeight": 1.4286,
        "letterSpacing": "0px"
      },
      "$description": "14 / 20. Buttons, filter chips, segments, nav links"
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "12px",
        "fontWeight": 500,
        "lineHeight": 1.3333,
        "letterSpacing": "0px"
      },
      "$description": "12 / 16. Hints, timestamps, tab labels, info chips"
    }
  }
}
